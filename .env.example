# Copy to .env and fill in. Any OpenAI-compatible endpoint works.

# --- Groq free tier (https://console.groq.com) ---
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_...
AGENT_MODEL=llama-3.3-70b-versatile
VLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- OpenRouter alternative (https://openrouter.ai) ---
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# AGENT_MODEL=meta-llama/llama-3.3-70b-instruct:free
# VLM_MODEL=qwen/qwen2.5-vl-72b-instruct:free

# --- Local Ollama fallback ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# AGENT_MODEL=qwen3:8b
# VLM_MODEL=qwen2.5vl:7b
